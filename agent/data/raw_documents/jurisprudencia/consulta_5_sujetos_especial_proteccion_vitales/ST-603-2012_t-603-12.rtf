{\rtlch\fcs1 \af0 \ltrch\fcs0 \cs29\lang1034\langfe3082\super\langnp1034\insrsid9258397\charrsid13312524 \chftn {\footnote \ltrpar \pard\plain \ltrpar\s21\qj \li0\ri0\widctlpar\wrapdefault\nooverflow\faroman\rin0\lin0\itap0\pararsid7473657 \rtlch\fcs1 
