\ltrch\fcs0 \lang9226\langfe3082\langnp9226\insrsid2841826 I}{\rtlch\fcs1 \af0 \ltrch\fcs0 \lang9226\langfe3082\langnp9226\insrsid3371196 I}{\rtlch\fcs1 \af0 \ltrch\fcs0 \lang9226\langfe3082\langnp9226\insrsid2841826 I. SENTENCIAS OBJETO DE REVISION

\par }\pard\plain \ltrpar\qj \li0\ri25\widctlpar\wrapdefault\aspalpha\aspnum\faauto\adjustright\rin25\lin0\itap0 \rtlch\fcs1 \af0\afs20\alang1025 \ltrch\fcs0 \fs20\lang3082\langfe3082\cgrid\langnp3082\langfenp3082 {\rtlch\fcs1 \af0 \ltrch\fcs0 
