\rtlch\fcs1 \af0\afs28 \ltrch\fcs0 \f0\fs28\super\insrsid8220886\charrsid1007321 \chftn {\footnote \ltrpar \pard\plain \ltrpar\s18\qj \li0\ri0\sl240\slmult0\widctlpar\wrapdefault\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid14039752 
